<mujoco model="CoMotion-X Panda and human replay scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <default class="human_marker">
      <geom type="sphere" size="0.035" rgba="0.95 0.25 0.15 1" contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="prediction_marker">
      <geom type="sphere" size="0.03" rgba="1.0 0.75 0.1 0" contype="0" conaffinity="0" group="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="human_torso" mocap="true" pos="0.9 0.35 1.05">
      <geom name="human_torso_marker" class="human_marker" size="0.07"/>
    </body>
    <body name="human_left_shoulder" mocap="true"><geom name="human_left_shoulder_marker" class="human_marker"/></body>
    <body name="human_right_shoulder" mocap="true"><geom name="human_right_shoulder_marker" class="human_marker"/></body>
    <body name="human_left_elbow" mocap="true"><geom name="human_left_elbow_marker" class="human_marker"/></body>
    <body name="human_right_elbow" mocap="true"><geom name="human_right_elbow_marker" class="human_marker"/></body>
    <body name="human_left_wrist" mocap="true"><geom name="human_left_wrist_marker" class="human_marker"/></body>
    <body name="human_right_wrist" mocap="true"><geom name="human_right_wrist_marker" class="human_marker"/></body>
    <body name="human_left_hip" mocap="true"><geom name="human_left_hip_marker" class="human_marker"/></body>
    <body name="human_right_hip" mocap="true"><geom name="human_right_hip_marker" class="human_marker"/></body>
    <body name="prediction_right_wrist_100" mocap="true">
      <geom name="prediction_right_wrist_100_marker" class="prediction_marker"/>
    </body>
    <body name="prediction_right_wrist_200" mocap="true">
      <geom name="prediction_right_wrist_200_marker" class="prediction_marker"/>
    </body>
    <body name="prediction_right_wrist_300" mocap="true">
      <geom name="prediction_right_wrist_300_marker" class="prediction_marker"/>
    </body>
    <body name="prediction_right_wrist_500" mocap="true">
      <geom name="prediction_right_wrist_500_marker" class="prediction_marker"/>
    </body>
  </worldbody>
</mujoco>
